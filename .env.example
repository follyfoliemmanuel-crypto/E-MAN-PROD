# Copiez ce fichier en « .env » (même dossier) puis remplissez-le.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

# --- Base de données (lue par l'API, jamais par le navigateur) ---
# Option A, recommandée : une branche « dev » de votre projet Neon
#   Neon Console > Branches > New branch « dev » > Connect > copier la chaîne
# DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Option B : PostgreSQL installé sur votre PC
# DATABASE_URL=postgresql://postgres:votremotdepasse@localhost:5432/emanprod
DATABASE_URL=

# Adresse du site, utilisée dans les liens envoyés par e-mail.
# En local : http://localhost:5173  ·  En ligne : https://www.emanprod.com
SITE_URL=http://localhost:5173

# --- E-mails transactionnels (facultatif : sans eux, les notifications restent dans les espaces) ---
# Fournisseur : resend ou brevo. Clé d'API créée chez le fournisseur (jamais dans le code).
MAIL_PROVIDER=resend
MAIL_API_KEY=
# Expéditeur : une adresse d'un domaine vérifié chez le fournisseur (ex. notifications@emanprod.com).
# Une adresse @gmail.com ne peut pas servir d'expéditeur : Resend n'envoie que depuis un domaine
# vérifié, et Brevo remplace les adresses gratuites par une adresse technique. Voir le README.
MAIL_FROM=E-MAN PROD <notifications@emanprod.com>
# Adresse de réponse : les clients qui répondent écrivent à l'atelier.
MAIL_REPLY_TO=emanprod3@gmail.com
# Facultatif : adresse qui reçoit les alertes de l'équipe (sinon : réglage Paramètres → Notifications,
# puis l'adresse de l'entreprise).
NOTIFY_TO=
# Anciennes variables encore acceptées : RESEND_API_KEY, BREVO_API_KEY.

# --- Sécurité ---
# Chaîne aléatoire d'au moins 32 caractères, propre à chaque environnement.
# Sert à anonymiser les adresses IP du journal de sécurité. Générer : openssl rand -base64 32
AUTH_SECRET=

# --- Connexion Google (facultatif) ---
# Google Cloud Console > API et services > Identifiants > ID client OAuth (type « Application Web »).
# Voir README, « Connexion Google ». Ne jamais préfixer ces variables par VITE_ (elles iraient au navigateur).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif : adresse de retour exacte déclarée chez Google. Par défaut : SITE_URL/api/auth/google-callback
# En local : http://localhost:5173/api/auth/google-callback · En ligne : https://www.emanprod.com/api/auth/google-callback
GOOGLE_REDIRECT_URI=

# --- Administrateur ---
# Adresse(s) qui deviennent administrateur à la connexion, SEULEMENT une fois l'adresse
# prouvée (connexion Google, ou lien de confirmation reçu par e-mail). Défaut : emanprod3@gmail.com
ADMIN_EMAILS=emanprod3@gmail.com

# --- Fichiers (Cloudinary, fournisseur unique) ---
# Console Cloudinary > Settings > API Keys. Ces trois valeurs restent sur le serveur
# (Vercel > Settings > Environment Variables) : ne jamais les préfixer par VITE_.
# Sans elles : en local, les fichiers vont dans le dossier .uploads/ ; en ligne, l'envoi
# de fichiers est désactivé (les clients passent par WhatsApp).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Facultatif : taille maximale d'un fichier imposée par votre offre Cloudinary, en Mo
# (offre gratuite : 10). À augmenter seulement après vérification de votre offre.
CLOUDINARY_MAX_FILE_MB=10
# Facultatif : dossier de l'application dans Cloudinary (défaut : emanprod).
CLOUDINARY_FOLDER=emanprod

# --- Sauvegarde indépendante (scripts, jamais sur Vercel) ---
# Dossier du poste d'E-MAN PROD où « npm run backup » copie la base et les fichiers
# (disque externe, NAS…). Cloudinary n'est pas une sauvegarde : voir docs/SAUVEGARDE.md.
BACKUP_DIR=

# --- Ancien stockage S3 (v3.0) : à garder seulement si des fichiers y sont encore ---
# Utilisé uniquement pour lire et supprimer les fichiers déjà enregistrés avec ce stockage,
# jusqu'à leur migration vérifiée (npm run files:migrate). Aucun nouvel envoi n'y est fait.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Navigateur ---
# Adresse publique du site, lue au build (URL canoniques, sitemap, aperçus de liens).
VITE_SITE_URL=https://www.emanprod.com
VITE_WHATSAPP_NUMBER=22891388405
VITE_CONTACT_EMAIL=
